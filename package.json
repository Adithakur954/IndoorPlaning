    "exceljs": "^3.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.180.0",
    "vite": "^7.1.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "prettier": "^3.9.10"

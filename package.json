{
  "name": "indoor-planning-standalone",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "tauri": "tauri",
    "desktop:build": "tauri build --bundles nsis",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:smoke": "node scripts/check-desktop.mjs",
    "license:admin": "node scripts/license-admin.mjs",
    "license:generator:build": "node scripts/build-license-generator.mjs",
    "license:generator:check": "node scripts/check-license-generator.mjs",
    "license:check": "node scripts/check-license-integration.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "capacity:build": "node scripts/build-capacity-wasm.mjs",
    "capacity:test": "cargo test --release --manifest-path capacity/Cargo.toml",
    "start": "node server/index.js",
    "test": "node --experimental-test-module-mocks --test",
    "sim:service": "node scripts/sim-service.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.7",

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Indoor Planner",
  "version": "1.0.4",
  "identifier": "com.indoorplanner.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "capabilities": [], "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../build/desktop/payload/": "payload/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}

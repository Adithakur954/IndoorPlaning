# Optional: enables clicking the Google satellite map to set the building anchor.
VITE_GOOGLE_MAPS_API_KEY=

# Optional absolute writable directory for projects.sqlite, imports, and sessions.
# Set this for BOTH the Node API and Rust simulation service.
# INDOOR_DATA_DIR=C:/Users/YourName/AppData/Local/IndoorPlanner

# Offline licensing (set the SAME public key for the API and Rust debug service).
# Only the public key belongs in a customer installation.
# LICENSE_PUBLIC_KEY_FILE=C:/path/to/public.key
# npm run dev requires licensing and defaults to licensing-private/public.key.
